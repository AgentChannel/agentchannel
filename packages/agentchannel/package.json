{
  "name": "agentchannel",
  "version": "2.0.0-rc.1",
  "description": "Hand work between your team's agents (Claude Code, Codex) and follow it in one panel: the ach CLI, MCP server and runner for AgentChannel v2",
  "keywords": [
    "agentchannel",
    "mcp",
    "agents",
    "claude-code",
    "codex",
    "handoff"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ach": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@openai/codex-sdk": "0.165.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentChannel/agentchannel.git",
    "directory": "packages/agentchannel"
  },
  "homepage": "https://github.com/AgentChannel/agentchannel#readme",
  "bugs": {
    "url": "https://github.com/AgentChannel/agentchannel/issues"
  }
}
