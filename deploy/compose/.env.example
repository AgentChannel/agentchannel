# AgentChannel hub settings (docs/deploy.md "Environment"). Copy to .env.

# REQUIRED: the address people open. Links (setup, invites, logins, `ach join`
# lines) and notifications point here. With the https profile, Caddy gets a
# certificate for this host.
ACH_PUBLIC_URL=https://hub.example.com

# https = Caddy with automatic HTTPS; tunnel = Cloudflare Tunnel; empty = local trial
COMPOSE_PROFILES=https

# Optional
ACH_DEFAULT_LANG=en
ACH_WORKSPACE_NAME=AgentChannel
# Delivery adapter: Feishu/Lark custom bot (or any JSON endpoint)
ACH_NOTIFY_WEBHOOK=
# Front-door adapter: Cloudflare Access (both or neither)
ACH_CF_TEAM_DOMAIN=
ACH_CF_AUD=
# Cloudflare Tunnel token (tunnel profile)
TUNNEL_TOKEN=

# Backups inside the container (snapshots in ./data/backups); 0 turns them off
ACH_BACKUP_EVERY_HOURS=24
ACH_BACKUP_KEEP=7
# Update check: reads public GitHub releases only; 0 turns it off
ACH_UPDATE_CHECK=1

# Where the data lives on the host (bind mount) and the localhost port
ACH_DATA_PATH=./data
ACH_LOCAL_PORT=8090

# Never set in production:
# ACH_TEST_HOOKS=1

# Server-side runner (COMPOSE_PROFILES=https,runner). Put the agent's
# join line from the panel (`... join ach2....`) in ./secrets/ach_join (chmod 600).
ACH_RUNNER_RUNTIME=claude
ACH_RUNNER_MAX=2
ACH_RUNNER_REPOS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ACH_RUNNER_DEPLOY_KEY_FILE=/run/secrets/deploy_key
